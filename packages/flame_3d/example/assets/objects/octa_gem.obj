# Octahedral gem exercising ObjParser mtllib, usemtl, v, vt, vn, and f
mtllib octa_gem.mtl
v 0.0 0.0 0.85
v 0.55 0.0 0.0
v 0.0 0.55 0.0
v -0.55 0.0 0.0
v 0.0 -0.55 0.0
v 0.0 0.0 -0.85
vt 0.5 1.0
vt 0.0 0.5
vt 1.0 0.5
vt 0.5 0.0
vn 0.577 0.577 0.577
vn -0.577 0.577 0.577
vn -0.577 -0.577 0.577
vn 0.577 -0.577 0.577
vn 0.577 0.577 -0.577
vn -0.577 0.577 -0.577
vn -0.577 -0.577 -0.577
vn 0.577 -0.577 -0.577
usemtl CyanFacet
f 1/1/1 2/2/1 3/3/1
f 1/1/2 3/2/2 4/3/2
f 1/1/3 4/2/3 5/3/3
f 1/1/4 5/2/4 2/3/4
usemtl GoldFacet
f 6/4/5 3/3/5 2/2/5
f 6/4/6 4/3/6 3/2/6
f 6/4/7 5/3/7 4/2/7
f 6/4/8 2/3/8 5/2/8
